server {
    listen 80;
    server_name localhost;

    root /var/www/html/thanos;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        root /var/www/html/thanos;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|ttf|woff|woff2|svg|eot|otf)$ {
        expires max;
        log_not_found off;
    }
}
